# Copie para .env na raiz; nunca faça commit de credenciais reais.
VULNRADAR_DATABASE_URL=sqlite:///./data/vulnradar.db
VULNRADAR_ALLOWED_ROOTS=[]
VULNRADAR_AUTO_SYNC=false
VULNRADAR_SYNC_MINUTES=60
# Chaves opcionais aumentam os limites das fontes.
# VULNRADAR_NVD_API_KEY=
# VULNRADAR_GITHUB_TOKEN=
# Limite agregado de conteúdo por scan (bytes).
VULNRADAR_MAX_SCAN_BYTES=100000000
# Webhook opcional: configure o URL completo somente no ambiente seguro.
# VULNRADAR_WEBHOOK_URL=
VULNRADAR_WEBHOOK_ALLOWED_HOSTS=[]
VULNRADAR_WEBHOOK_FORMAT=generic
VULNRADAR_NOTIFICATION_INTERVAL_SECONDS=60
# OCI opcional: somente registros explicitamente autorizados.
VULNRADAR_OCI_REGISTRIES=["docker.io","registry-1.docker.io","ghcr.io","quay.io"]
VULNRADAR_OCI_TIMEOUT=600
VULNRADAR_OSV_BATCH=true
