# Copie para .env na raiz; nunca faça commit de credenciais reais.
VULNRADAR_DATABASE_URL=sqlite:///./data/vulnradar.db
VULNRADAR_ALLOWED_ROOTS=[]
VULNRADAR_AUTO_SYNC=false
VULNRADAR_SYNC_MINUTES=60
# Chaves opcionais aumentam os limites das fontes.
# VULNRADAR_NVD_API_KEY=
# VULNRADAR_GITHUB_TOKEN=
# Limite agregado de conteúdo por scan (bytes).
VULNRADAR_MAX_SCAN_BYTES=100000000
# Webhook opcional: configure o URL completo somente no ambiente seguro.
# VULNRADAR_WEBHOOK_URL=
VULNRADAR_WEBHOOK_ALLOWED_HOSTS=[]
VULNRADAR_WEBHOOK_FORMAT=generic
VULNRADAR_NOTIFICATION_INTERVAL_SECONDS=60
VULNRADAR_OSV_BATCH=true
# Privacidade: habilite somente após avaliar o envio de nomes/versões ao OSV.
VULNRADAR_OSV_QUERIES_ENABLED=false
VULNRADAR_STORE_CODE_SNIPPETS=false
VULNRADAR_ALLOW_LOCAL_SAST_IN_TEAM=false
VULNRADAR_NVD_BACKFILL_DAYS=7
# Equipe: configure mode=team, hosts e origens HTTPS explícitos e chaves pessoais.
# Gere chaves com python scripts/create_access_key.py admin-01 --role admin
# Mescle os hashes das contas; nunca armazene a chave pessoal nesta variável.
VULNRADAR_ACCESS_MODE=local
VULNRADAR_ACCESS_KEYS={}
# VULNRADAR_ALLOWED_HOSTS=["radar.interno.example"]
# VULNRADAR_ORIGINS=["https://radar.interno.example"]
VULNRADAR_SESSION_MINUTES=480
VULNRADAR_SESSION_IDLE_MINUTES=30
VULNRADAR_REQUESTS_PER_MINUTE=600
VULNRADAR_MUTATIONS_PER_MINUTE=60
VULNRADAR_RETENTION_PROGRESS_DAYS=0
VULNRADAR_RETENTION_DELIVERY_DAYS=0
# SMTP opcional, canal exclusivo (webhook ou smtp), TLS implícito na porta 465.
VULNRADAR_NOTIFICATION_CHANNEL=webhook
# VULNRADAR_SMTP_HOST=smtp.interno.example
# VULNRADAR_SMTP_ALLOWED_HOSTS=["smtp.interno.example"]
# VULNRADAR_SMTP_SENDER=radar@example.com
# VULNRADAR_SMTP_RECIPIENTS=["appsec@example.com"]
# VULNRADAR_SMTP_USERNAME=
# VULNRADAR_SMTP_PASSWORD=
